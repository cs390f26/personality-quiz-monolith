[Unit]
Description=Personality Quiz Monolith
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type-simple
User=ec2-user
WorkingDirectory=/home/ec2-user/personality-quiz-monolith
EnvironmentFile=/home/ec2-user/personality-quiz-monolith/.env
# Bind to port 80 without running the whole process as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/home/ec2-user/personality-quiz-monolith/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:80 'personality-quiz.app:launch()'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target